<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Configurations>Release;Debug;</Configurations>
    <Platforms>x64</Platforms>
    <IsPackable>false</IsPackable>
    <Authors />
    <ApplicationIcon>MIDA.ico</ApplicationIcon>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
      <None Remove="Changelog.json" />
      <None Remove="HLSLSyntax.xshd" />
      <None Remove="Shaders\pixelated_gradient.fx" />
      <None Remove="Shaders\procedural_spinner.ps.cso" />
      <None Remove="Shaders\procedural_spinner.ps.hlsl" />
      <None Remove="Shaders\procedural_spinner.vs.cso" />
      <None Remove="Shaders\procedural_spinner.vs.hlsl" />
      <None Remove="ThirdParty\dxil\dxbc2dxil.exe" />
      <None Remove="ThirdParty\dxil\dxcompiler.dll" />
      <None Remove="ThirdParty\dxil\dxil-spirv-c-shared.dll" />
      <None Remove="ThirdParty\dxil\dxil-spirv.exe" />
      <None Remove="ThirdParty\dxil\dxilconv.dll" />
      <None Remove="ThirdParty\dxil\HLSLDecompiler.exe" />
      <None Remove="ThirdParty\dxil\spirv-cross.exe" />
      <None Remove="ThirdParty\fonts\CodeLanguage.otf" />
      <None Remove="ThirdParty\fonts\GoliathBeta-Encrypted.otf" />
      <None Remove="ThirdParty\fonts\marathonshapiro_wide65.otf" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
      <PackageReference Include="ConcurrentHashSet" Version="1.3.0" />
      <PackageReference Include="HelixToolkit.SharpDX.Assimp" Version="3.1.2" />
      <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
      <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
      <PackageReference Include="MaterialDesignThemes" Version="5.0.0-ci330" />
      <PackageReference Include="MaterialDesignThemes" Version="5.3.1-ci1292" />
      <PackageReference Include="Microsoft.Toolkit.Mvvm" Version="7.1.2" />
      <PackageReference Include="NAudio" Version="2.2.1" />
      <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
      <PackageReference Include="Restless.WaveForm" Version="1.1.0" />
      <PackageReference Include="VersionChecker" Version="1.1.0" />
      <PackageReference Include="VirtualizingWrapPanel" Version="2.5.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Tiger\Tiger.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="Settings\ConfigSettingControl.xaml">
        <Generator>MSBuild:Compile</Generator>
        <DependentUpon>ConfigView.xaml</DependentUpon>
      </Page>
      <Page Update="Activity\ActivityMapView.xaml">
        <Generator>MSBuild:Compile</Generator>
        <DependentUpon>ActivityView.xaml</DependentUpon>
      </Page>
      <Page Update="Activity\ActivityDialogueView.xaml">
        <Generator>MSBuild:Compile</Generator>
        <DependentUpon>ActivityView.xaml</DependentUpon>
      </Page>
      <Page Update="Activity\ActivityDirectiveView.xaml">
        <Generator>MSBuild:Compile</Generator>
        <DependentUpon>ActivityView.xaml</DependentUpon>
      </Page>
      <Page Update="Activity\ActivityMusicView.xaml">
        <Generator>MSBuild:Compile</Generator>
        <DependentUpon>ActivityView.xaml</DependentUpon>
      </Page>
      <Page Update="Views\TagListView.xaml">
        <Generator>MSBuild:Compile</Generator>
        <DependentUpon>TagListViewerView.xaml</DependentUpon>
      </Page>
      <Page Update="Settings\ConfigSettingComboControl.xaml">
        <Generator>MSBuild:Compile</Generator>
        <DependentUpon>ConfigView.xaml</DependentUpon>
      </Page>
      <Page Update="Views\TagView.xaml">
        <Generator>MSBuild:Compile</Generator>
        <DependentUpon>TagListViewerView.xaml</DependentUpon>
      </Page>
      <Page Update="Music\MusicWemsControl.xaml">
        <Generator>MSBuild:Compile</Generator>
        <DependentUpon>MusicView.xaml</DependentUpon>
      </Page>
      <Page Update="Music\MusicEventsControl.xaml">
        <Generator>MSBuild:Compile</Generator>
        <DependentUpon>MusicView.xaml</DependentUpon>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <None Update="Shaders\Spinner.ps">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\FbxWrapperNative.dll">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\librevorb.dll">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\oo2core_3_win64.dll">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\oo2core_9_win64.dll">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\packed_codebooks_aoTuV_603.bin">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>


    <ItemGroup>
      <Content Include="..\Tiger\Exporters\Shaders\TFXFunctions.hlsl">
        <Link>Shaders\TFXFunctions.hlsl</Link>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Content Include="HLSLSyntax.xshd">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="MIDA.ico" />
      <Content Include="Shaders\pixelated_gradient.fx">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Content Include="Shaders\procedural_spinner.ps.cso">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Shaders\procedural_spinner.ps.hlsl">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Shaders\procedural_spinner.vs.cso">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Shaders\procedural_spinner.vs.hlsl">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="ThirdParty\vgmstream\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>


    <ItemGroup>
      <Content Include="Changelog.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Content Include="ThirdParty\dxil\dxil-spirv-c-shared.dll">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Content Include="ThirdParty\dxil\dxil-spirv.exe">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Content Include="ThirdParty\dxil\dxilconv.dll">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Content Include="ThirdParty\dxil\HLSLDecompiler.exe">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Content Include="ThirdParty\dxil\spirv-cross.exe">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Resource Include="ThirdParty\fonts\CodeLanguage.otf" />
      <Resource Include="ThirdParty\fonts\GoliathBeta-Encrypted.otf" />
      <Resource Include="ThirdParty\fonts\marathonshapiro_wide65.otf" />
    </ItemGroup>

