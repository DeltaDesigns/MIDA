<UserControl
    x:Class="MIDA.Changelog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MIDA"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1017"
    d:DesignWidth="1920"
    KeyDown="UserControl_KeyDown"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ChangelogButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#BBBBBB" />
            <Setter Property="FontFamily" Value="{DynamicResource PP Fraktion Mono Medium}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="10" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Cursor="Hand">
                            <Border
                                x:Name="Main"
                                Background="{StaticResource MarathonDark}"
                                BorderBrush="Transparent"
                                BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:StyleHelper.BorderThickness)}"
                                CornerRadius="0">
                                <Grid Margin="5,0,15,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="Symbol"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Bottom"
                                        FontFamily="{DynamicResource KH Interference Regular Keys}"
                                        FontSize="60"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="" />

                                    <TextBlock
                                        x:Name="Text"
                                        Grid.Column="1"
                                        Margin="0,0,0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                        FontSize="26"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{Binding Version}" />

                                    <TextBlock
                                        x:Name="Text2"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                        FontSize="18"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{Binding Date}" />
                                </Grid>
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="Main"
                                                Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                To="{StaticResource MarathonDarkerC}"
                                                Duration="0:0:0.1" />
                                            <ColorAnimation
                                                Storyboard.TargetName="Symbol"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#BBBBBB"
                                                Duration="0:0:0.1" />
                                            <ColorAnimation
                                                Storyboard.TargetName="Text"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#BBBBBB"
                                                Duration="0:0:0.1" />
                                            <ColorAnimation
                                                Storyboard.TargetName="Text2"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#BBBBBB"
                                                Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="Main"
                                                Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                To="#BBBBBB"
                                                Duration="0:0:0.1" />
                                            <ColorAnimation
                                                Storyboard.TargetName="Symbol"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#111111"
                                                Duration="0:0:0.1" />
                                            <ColorAnimation
                                                Storyboard.TargetName="Text"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#111111"
                                                Duration="0:0:0.1" />
                                            <ColorAnimation
                                                Storyboard.TargetName="Text2"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#111111"
                                                Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="Main"
                                                Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                To="#B0B0B0"
                                                Duration="0:0:0.1" />
                                            <ColorAnimation
                                                Storyboard.TargetName="Symbol"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#111111"
                                                Duration="0:0:0.1" />
                                            <ColorAnimation
                                                Storyboard.TargetName="Text"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#111111"
                                                Duration="0:0:0.1" />

                                            <ColorAnimation
                                                Storyboard.TargetName="Text2"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#111111"
                                                Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="Main"
                                                Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                To="#DDDDDD"
                                                Duration="0:0:0.1" />
                                            <ColorAnimation
                                                Storyboard.TargetName="Symbol"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#111111"
                                                Duration="0:0:0.1" />
                                            <ColorAnimation
                                                Storyboard.TargetName="Text"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#111111"
                                                Duration="0:0:0.1" />

                                            <ColorAnimation
                                                Storyboard.TargetName="Text2"
                                                Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                To="#111111"
                                                Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.Setters>
                                    <Setter Property="Cursor" Value="Hand" />
                                </Trigger.Setters>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChangelogEntry">
            <RadioButton
                Margin="0,5,0,5"
                Click="ChangelogEntry_Click"
                GroupName="VersionButtons"
                MouseEnter="ChangelogEntry_MouseEnter"
                Style="{DynamicResource ChangelogButton}"
                Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </DataTemplate>

        <DataTemplate x:Key="ChangesTemplate">
            <StackPanel Margin="0,0,0,15" Orientation="Vertical">
                <TextBlock
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    FontFamily="{DynamicResource KH Interference Regular Keys}"
                    FontSize="24"
                    Foreground="{StaticResource ForegroundColour100}"
                    Text="{Binding Title}" />

                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5,0,5" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    d:FontFamily="Haas Grot Text 55 Roman"
                                    FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                    FontSize="22"
                                    Foreground="{StaticResource ForegroundColour70}"
                                    Text="•"
                                    TextWrapping="WrapWithOverflow" />

                                <TextBlock
                                    Grid.Column="1"
                                    d:FontFamily="Haas Grot Text 55 Roman"
                                    FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                    FontSize="22"
                                    Foreground="{StaticResource ForegroundColour70}"
                                    Text="{Binding}"
                                    TextWrapping="WrapWithOverflow" />
                            </Grid>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#D0000000">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Button
            Name="Exit"
            Width="50"
            Height="50"
            Margin="25"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="Exit_Click"
            Opacity="1"
            Style="{StaticResource MarathonStyleButton}">
            <TextBlock
                Margin="0,5,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:FontFamily="Haas Grot Text 55 Roman"
                FontFamily="{DynamicResource KH Interference Regular Keys}"
                FontSize="36"
                Foreground="{StaticResource BackgroundColour7}"
                Text="X" />
        </Button>

        <Grid Margin="100,25,100,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="15*" />
                <RowDefinition Height="90*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    d:FontFamily="Haas Grot Text 55 Roman"
                    FontFamily="{DynamicResource KH Interference Regular Keys}"
                    FontSize="46"
                    Foreground="{StaticResource ForegroundColour90}"
                    Text=" CHANGELOG" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*" />
                    <ColumnDefinition Width="70*" />
                </Grid.ColumnDefinitions>

                <local:ItemPage
                    x:Name="ChangelogVersions"
                    Grid.Column="0"
                    CollapsePageButtons="True"
                    Columns="1"
                    IsVertical="True"
                    ItemTemplate="{StaticResource ChangelogEntry}"
                    ItemsPerPage="10"
                    UsePlaceholders="True" />

                <Grid
                    Grid.Column="2"
                    Margin="50,0,50,0"
                    Background="{StaticResource MarathonDarker}"
                    Visibility="Visible">
                    <Grid
                        x:Name="ChangeLogPanel"
                        Margin="50,25,50,25"
                        Visibility="Hidden">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Margin="0,0,0,25"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="-10,0,10,0"
                                VerticalAlignment="Center"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource KH Interference Regular Keys}"
                                FontSize="55"
                                Foreground="{StaticResource MarathonGreen}"
                                Text="" />
                            <TextBlock
                                VerticalAlignment="Center"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource KH Interference Regular Keys}"
                                FontSize="36"
                                Foreground="{StaticResource MarathonGreen}"
                                Text="{Binding Version}" />
                        </StackPanel>


                        <Grid Grid.Row="1">
                            <Border
                                Margin="0,-20,0,0"
                                VerticalAlignment="Top"
                                BorderBrush="White"
                                BorderThickness="0,1,0,1"
                                Opacity=".5"
                                Visibility="Visible" />

                            <ScrollViewer
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style BasedOn="{StaticResource BorderedScrollBar}" TargetType="ScrollBar">
                                        <Setter Property="Width" Value="7" />
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel>
                                    <ItemsControl
                                        Margin="0,0,25,0"
                                        Background="Transparent"
                                        ItemTemplate="{StaticResource ChangesTemplate}"
                                        ItemsSource="{Binding Changes}"
                                        KeyboardNavigation.TabNavigation="None"
                                        ScrollViewer.CanContentScroll="False"
                                        VirtualizingPanel.IsContainerVirtualizable="True"
                                        VirtualizingPanel.ScrollUnit="Pixel">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>


        </Grid>
    </Grid>

</UserControl>
