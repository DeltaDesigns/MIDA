<UserControl
    x:Class="MIDA.PopupBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MIDA"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="1920"
    KeyboardNavigation.ControlTabNavigation="None"
    KeyboardNavigation.DirectionalNavigation="None"
    KeyboardNavigation.TabNavigation="None"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:SpacedTextConverter x:Key="SpacedTextConverter" />
        <QuinticEase x:Key="EaseOut" EasingMode="EaseInOut" />

        <Storyboard x:Key="PopupFadeAnimation" Completed="FadeOutAnimation_Completed">
            <DoubleAnimation
                Storyboard.TargetName="ElementStack"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.05" />
        </Storyboard>

        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid
                            x:Name="TemplateRoot"
                            Background="Transparent"
                            SnapsToDevicePixels="true">
                            <!--  Background  -->
                            <Border
                                x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True" />
                            <!--  Progress Bar  -->
                            <Border
                                x:Name="PART_Indicator"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!--  Trigger for Fade-In Animation  -->
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_Indicator"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0"
                                            To="1"
                                            Duration="0:0:2.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="MainGrid"
        Panel.ZIndex="100"
        Background="Transparent"
        Focusable="False"
        KeyboardNavigation.ControlTabNavigation="None"
        KeyboardNavigation.DirectionalNavigation="None"
        KeyboardNavigation.TabNavigation="None">

        <Border
            x:Name="ElementStack"
            Margin="100"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="{StaticResource MarathonDark}">

            <StackPanel Orientation="Vertical">
                <Grid
                    Name="Expanders"
                    d:Opacity="1"
                    Background="Transparent"
                    Opacity="0"
                    Visibility="Visible">
                    <!--  Left Piece (Expands Left)  -->
                    <Rectangle
                        Name="LeftPiece"
                        Width="0"
                        Height="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Panel.ZIndex="15"
                        d:Fill="#88007490"
                        d:Width="1920"
                        Fill="{Binding ExpanderColor}"
                        Visibility="Collapsed" />

                    <!--  Right Piece (Expands Right)  -->
                    <Rectangle
                        Name="RightPiece"
                        Width="0"
                        Height="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Panel.ZIndex="15"
                        d:Fill="#88007490"
                        d:Width="1920"
                        Fill="{Binding ExpanderColor}"
                        Visibility="Collapsed" />

                    <Border
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        d:Background="#4B007490"
                        Background="{Binding BodyColor}">
                        <TextBlock
                            Margin="20"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            d:Text="H E L L O"
                            FontFamily="{DynamicResource Marathon Shapiro}"
                            FontSize="36"
                            FontWeight="Bold"
                            Foreground="White">
                            <Run Text="! " />
                            <Run Text="{Binding Title, Converter={StaticResource SpacedTextConverter}}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <Grid
                    Name="Info"
                    d:Opacity="1"
                    Background="Transparent"
                    Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1" Background="Transparent">
                        <TextBlock
                            x:Name="TextIcon"
                            Margin="25"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            d:Foreground="#C90092B6"
                            d:Text="✅"
                            FontFamily="{DynamicResource KH Interference Regular Keys}"
                            FontSize="300"
                            FontWeight="Bold"
                            Foreground="{Binding IconColor}"
                            Text="{Binding Icon}" />

                        <Grid
                            x:Name="DefaultIconsGrid"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            Visibility="Collapsed">
                            <Grid
                                x:Name="InfoIcon"
                                Grid.Column="0"
                                Width="120"
                                Height="120"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Hidden">

                                <Border
                                    Name="InfoOuter"
                                    Width="120"
                                    Height="120"
                                    BorderBrush="{Binding IconColor}"
                                    BorderThickness="2"
                                    CornerRadius="100"
                                    Opacity="0.5"
                                    RenderTransformOrigin="0.5,0.5" />

                                <Border
                                    Name="InfoInner"
                                    Width="107"
                                    Height="107"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="{Binding IconColor}"
                                    BorderThickness="2"
                                    CornerRadius="100"
                                    Opacity="0.9"
                                    RenderTransformOrigin="0.5,0.5" />

                                <Border
                                    Name="InfoInnerCircle"
                                    Width="54"
                                    Height="54"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding IconColor}"
                                    BorderBrush="{Binding IconColor}"
                                    CornerRadius="100"
                                    Opacity="0.2"
                                    RenderTransformOrigin="0.5,0.5" />

                                <Border
                                    Name="InfoExclamation1"
                                    Width="18"
                                    Height="44"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding IconColor}"
                                    BorderBrush="{Binding IconColor}"
                                    Opacity="1"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" Y="15" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border
                                    Name="InfoExclamation2"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding IconColor}"
                                    BorderBrush="{Binding IconColor}"
                                    CornerRadius="100"
                                    Opacity="1"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" Y="-25" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <Grid
                                x:Name="AlertIcon"
                                Grid.Column="0"
                                Width="120"
                                Height="120"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Hidden">

                                <Border
                                    Name="AlertOuter"
                                    Width="120"
                                    Height="120"
                                    BorderBrush="{Binding IconColor}"
                                    BorderThickness="2"
                                    Opacity="0.5"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.7071" ScaleY="0.7071" />
                                            <RotateTransform Angle="45" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>

                                <Border
                                    Name="AlertInner"
                                    Width="107"
                                    Height="107"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="{Binding IconColor}"
                                    BorderThickness="2"
                                    Opacity="0.9"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.7071" ScaleY="0.7071" />
                                            <RotateTransform Angle="45" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>

                                <Border
                                    Name="AlertInnerCircle"
                                    Width="54"
                                    Height="54"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding IconColor}"
                                    BorderBrush="{Binding IconColor}"
                                    CornerRadius="100"
                                    Opacity="0.2"
                                    RenderTransformOrigin="0.5,0.5" />

                                <Border
                                    Name="AlertExclamation1"
                                    Width="18"
                                    Height="44"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding IconColor}"
                                    BorderBrush="{Binding IconColor}"
                                    Opacity="1"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" Y="-15" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border
                                    Name="AlertExclamation2"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding IconColor}"
                                    BorderBrush="{Binding IconColor}"
                                    CornerRadius="100"
                                    Opacity="1"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" Y="25" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1.75" ScaleY="1.75" />
                            </Grid.RenderTransform>
                        </Grid>

                    </Grid>


                    <Image
                        Grid.Column="1"
                        Margin="25"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Source="{Binding IconImage}"
                        Stretch="Uniform"
                        Visibility="Visible" />

                    <Grid Grid.Column="0" Margin="50,50,50,20">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Vertical">
                            <TextBlock
                                x:Name="SubtitleText"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource KH Interference Regular}"
                                FontSize="26"
                                FontWeight="Bold"
                                Foreground="{StaticResource MarathonYellow}"
                                TextWrapping="WrapWithOverflow">
                                <Run d:Text="Subtitle" Text="{Binding Subtitle}" />
                                <Run Text="&#x0a;" />
                            </TextBlock>

                            <TextBlock
                                x:Name="DescriptionText"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                d:Text="Description"
                                FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                FontSize="22"
                                Text="{Binding Description}"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>

                        <Grid
                            Name="Input"
                            Grid.Row="1"
                            Margin="0,50,0,0"
                            VerticalAlignment="Bottom"
                            Background="Transparent">
                            <Grid Background="Transparent">
                                <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                                    <Grid
                                        x:Name="MainUserInput"
                                        Margin="0,5,5,0"
                                        Background="Transparent">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            d:FontFamily="Haas Grot Text 55 Roman"
                                            FontFamily="{DynamicResource Marathon PC Keys}"
                                            FontSize="20"
                                            Foreground="{StaticResource ForegroundColour90}"
                                            Text=""
                                            TextWrapping="WrapWithOverflow" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            d:FontFamily="Haas Grot Text 55 Roman"
                                            FontFamily="{DynamicResource Marathon PC Keys}"
                                            FontSize="20"
                                            Foreground="#3396DA"
                                            Text=""
                                            TextWrapping="WrapWithOverflow" />
                                    </Grid>

                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        d:FontFamily="Haas Grot Text 55 Roman"
                                        FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                        FontSize="20"
                                        Foreground="{StaticResource ForegroundColour90}"
                                        Text="{Binding UserInput}"
                                        TextWrapping="WrapWithOverflow" />

                                    <Grid
                                        x:Name="SecondaryUserInput"
                                        Margin="20,5,5,0"
                                        Background="Transparent">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            d:FontFamily="Haas Grot Text 55 Roman"
                                            FontFamily="{DynamicResource Marathon PC Keys}"
                                            FontSize="20"
                                            Foreground="{StaticResource ForegroundColour90}"
                                            Text=""
                                            TextWrapping="WrapWithOverflow" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            d:FontFamily="Haas Grot Text 55 Roman"
                                            FontFamily="{DynamicResource Marathon PC Keys}"
                                            FontSize="20"
                                            Foreground="#3396DA"
                                            Text=""
                                            TextWrapping="WrapWithOverflow" />
                                    </Grid>

                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        d:FontFamily="Haas Grot Text 55 Roman"
                                        FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                        FontSize="20"
                                        Foreground="{StaticResource ForegroundColour90}"
                                        Text="{Binding UserInputSecondary}"
                                        TextWrapping="WrapWithOverflow" />
                                </StackPanel>
                            </Grid>


                            <Border
                                Grid.Column="1"
                                Panel.ZIndex="-1"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                                <ProgressBar
                                    x:Name="HoldProgress"
                                    Height="auto"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Foreground="#FF6D99FF"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="0" />

                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    AutoReverse="True"
                                                    RepeatBehavior="Forever"
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0.5"
                                                    To="1.0"
                                                    Duration="0:0:0.75">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>
                    </Grid>


                </Grid>


            </StackPanel>
        </Border>


        <!--  Animations  -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="Expanders"
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25" />

                        <!--  Left Piece Expands Left  -->
                        <DoubleAnimation
                            EasingFunction="{StaticResource EaseOut}"
                            Storyboard.TargetName="LeftPiece"
                            Storyboard.TargetProperty="Width"
                            From="0"
                            To="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Duration="0:0:0.35" />


                        <!--  Right Piece Expands Right  -->
                        <DoubleAnimation
                            EasingFunction="{StaticResource EaseOut}"
                            Storyboard.TargetName="RightPiece"
                            Storyboard.TargetProperty="Width"
                            From="0"
                            To="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Duration="0:0:0.35" />

                        <!--  Defaults  -->
                        <DoubleAnimation
                            BeginTime="0"
                            Storyboard.TargetName="Info"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0" />
                        <DoubleAnimation
                            BeginTime="0"
                            Storyboard.TargetName="Input"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0" />


                        <DoubleAnimation
                            BeginTime="0:0:0.3"
                            Storyboard.TargetName="Info"
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.15" />
                        <DoubleAnimation
                            BeginTime="0:0:0.3"
                            Storyboard.TargetName="Input"
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.15" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

    </Grid>
</UserControl>
