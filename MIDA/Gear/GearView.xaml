<UserControl
    x:Class="MIDA.GearView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MIDA"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="990"
    d:DesignWidth="1920"
    Focusable="True"
    KeyDown="UserControl_KeyDown"
    KeyboardNavigation.ControlTabNavigation="None"
    KeyboardNavigation.DirectionalNavigation="None"
    KeyboardNavigation.TabNavigation="None"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>

        <DataTemplate x:Key="ItemIconTemplate">
            <Grid>
                <Image
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{Binding Icon}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemIconWatermarkTemplate">
            <!--  Icon Watermark  -->
            <Grid
                Width="28"
                Height="48"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <!--  Visibility="{Binding ItemWatermark, Converter={StaticResource NullToVisibilityConverter}}">  -->
                <Rectangle
                    Grid.Row="1"
                    Width="22"
                    Height="48"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Opacity="0.6"
                    RenderOptions.EdgeMode="Aliased"
                    Stretch="Fill">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="Black" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  Featured item banner  -->
                <Polygon
                    Width="28"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="#109191"
                    Points="0,0 0,32 14,28 28,32 28,0">
                    <Polygon.Style>
                        <Style TargetType="Polygon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Hash, Converter={StaticResource Investment_IsFeaturedItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Polygon.Style>
                </Polygon>

                <Image
                    Width="20"
                    Height="20"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Source="{Binding ItemWatermark}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CategoryHeader">
            <Grid Width="400" Opacity="0.75">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="1"
                                    Duration="0:0:0.075" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="0.5"
                                    Duration="0:0:0.075" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <Viewbox
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    StretchDirection="DownOnly">
                    <TextBlock
                        Margin="0,0,0,0"
                        Panel.ZIndex="1"
                        FontFamily="{DynamicResource Marathon Shapiro}"
                        FontSize="22"
                        Foreground="White"
                        Text="{Binding CategoryName}" />
                </Viewbox>
            </Grid>

        </DataTemplate>


        <DataTemplate x:Key="WeaponAttachmentEntry">
            <Grid Background="Transparent">
                <Grid Focusable="False" IsHitTestVisible="False">
                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,0,0,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,1,0,0"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,0,1,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,1,1,0"
                        Focusable="False" />
                </Grid>

                <Grid Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <RadioButton
                        Width="210"
                        Height="50"
                        local:StyleHelper.BorderThickness="0.75"
                        Checked="AttachmentItem_Checked"
                        Focusable="False"
                        GroupName="{Binding Index}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        IsHitTestVisible="True"
                        Style="{StaticResource D2StyleRadioButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="Root"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Background="Transparent"
                                RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Border.Effect>
                                    <local:PixelGradientEffect
                                        Width="{Binding ActualWidth, ElementName=Root}"
                                        Height="{Binding ActualHeight, ElementName=Root}"
                                        Center="-.25,0"
                                        ColorA="{Binding RarityColor}"
                                        ColorB="{StaticResource MarathonDarkerC}"
                                        Falloff="0.75"
                                        PixelSize="12,12" />
                                </Border.Effect>
                            </Border>
                            <Polygon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Fill="{StaticResource MarathonYellow}"
                                Points="0, 0 -25, 0, 0, 25"
                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Grid
                                Margin="5,0,10,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource Marathon Shapiro}"
                                    FontSize="16"
                                    Text="{Binding Item.Name}"
                                    TextWrapping="WrapWithOverflow">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Item.Rarity}" Value="Dynamic">
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </Grid>
                        </Grid>
                    </RadioButton>

                    <Border
                        BorderBrush="{Binding RarityColor, Converter={StaticResource ColorToBrush}}"
                        BorderThickness="1"
                        Focusable="False" />
                    <!--  Style="{StaticResource GreyBorderWhiteOnHover}" />  -->
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AttachmentSelectionTemplate">
            <Grid>
                <Grid
                    MaxHeight="96"
                    Margin="2"
                    Background="{StaticResource MarathonDark}">
                    <local:HoverPopupWrapper PopupParent="{x:Type local:WeaponAttachmentEntry}">
                        <local:HoverPopupWrapper.Target>
                            <ContentControl Grid.Row="0" Margin="0">
                                <ContentControl.Template>
                                    <ControlTemplate>
                                        <Border
                                            Background="{Binding SelectedAttachment.RarityColor, Converter={StaticResource ColorToBrush}}"
                                            BorderBrush="{StaticResource MarathonDark}"
                                            BorderThickness="1"
                                            KeyboardNavigation.TabNavigation="None">
                                            <Button
                                                Click="AttachmentItem_Checked"
                                                MouseEnter="AttachmentItem_MouseEnter"
                                                MouseLeave="AttachmentItem_MouseLeave"
                                                MouseRightButtonUp="AttachmentItem_Uncheck"
                                                Style="{StaticResource ButtonTransparent}">
                                                <Image
                                                    Width="32"
                                                    Height="32"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="{Binding EntryIconSelected}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedAttachment}" Value="{x:Null}">
                                                                    <Setter Property="Source" Value="{Binding EntryIcon}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                    <Image.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="2"
                                                            Direction="0"
                                                            ShadowDepth="0"
                                                            Color="Black" />
                                                    </Image.Effect>
                                                </Image>
                                            </Button>
                                        </Border>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>

                        </local:HoverPopupWrapper.Target>
                        <local:HoverPopupWrapper.PopupContent>
                            <!--  -5 on the top so it slightly overlays with the target, just for hittest sake  -->
                            <Grid Margin="0,-5,0,0" DataContext="{Binding}">
                                <Grid Margin="0,10,0,0" Background="{StaticResource MarathonDark}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.RowSpan="2"
                                        BorderBrush="{StaticResource MarathonGray}"
                                        BorderThickness="2"
                                        Focusable="False" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="10,10,0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Panel.ZIndex="1"
                                        FontFamily="{DynamicResource Marathon Shapiro}"
                                        FontSize="16"
                                        Text="{Binding AttachmentTypeString}"
                                        TextWrapping="WrapWithOverflow" />

                                    <local:ItemPage
                                        Grid.Row="1"
                                        Margin="5"
                                        VerticalAlignment="Top"
                                        CollapsePageButtons="True"
                                        Columns="1"
                                        IsVertical="True"
                                        ItemMargin="4"
                                        ItemTemplate="{StaticResource WeaponAttachmentEntry}"
                                        Items="{Binding Attachments}"
                                        ItemsPerPage="5"
                                        PageButtonSize="20"
                                        SelectOnPageChange="False"
                                        SlideDistance="5"
                                        TransitionSpeed="0.05"
                                        UsePlaceholders="True" />
                                </Grid>

                            </Grid>

                        </local:HoverPopupWrapper.PopupContent>
                    </local:HoverPopupWrapper>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DareSelectedEntry">
            <Grid Height="92" Background="Transparent">
                <Grid Loaded="DareSelectedEntry_Loaded" Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="Root"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Background="Transparent"
                        RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Border.Effect>
                            <local:PixelGradientEffect
                                Width="{Binding ActualWidth, ElementName=Root}"
                                Height="{Binding ActualHeight, ElementName=Root}"
                                Center="-.25,0"
                                ColorA="{Binding RarityColor}"
                                ColorB="{StaticResource MarathonDarkerC}"
                                Falloff="0.75"
                                PixelSize="18,18" />
                        </Border.Effect>
                    </Border>

                    <Border
                        Grid.ColumnSpan="3"
                        BorderThickness="2"
                        Focusable="False"
                        Opacity="1"
                        Style="{StaticResource GreyBorderWhiteOnHover}" />

                    <Button
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Stretch"
                        local:StyleHelper.BorderThickness="0.75"
                        Click="SelectedDareEntry_Click"
                        Focusable="False"
                        IsHitTestVisible="True"
                        Style="{StaticResource ButtonTransparent}" />

                    <!--  Attachment Selection  -->
                    <Grid
                        Grid.Column="0"
                        Width="88"
                        Margin="2,2,0,2"
                        HorizontalAlignment="Stretch"
                        Background="{Binding RarityColor, Converter={StaticResource ColorToBrush}}"
                        Visibility="{Binding WeaponAttachments.Entries, Converter={StaticResource IsCollectionEmptyToVisConverter}}">
                        <Border
                            Margin="0,0,0,0"
                            BorderBrush="White"
                            BorderThickness="0,0,0,0"
                            Opacity="0.75" />
                        <ItemsControl ItemTemplate="{StaticResource AttachmentSelectionTemplate}" ItemsSource="{Binding WeaponAttachments.Entries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" Rows="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <!--  Item Details  -->
                    <Grid
                        Grid.Column="1"
                        Grid.ColumnSpan="1"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <StackPanel Margin="10,0,10,0" Orientation="Vertical">
                            <Viewbox
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                StretchDirection="DownOnly">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Panel.ZIndex="1"
                                        FontFamily="{DynamicResource KH Interference Regular Keys}"
                                        FontSize="24"
                                        Text="{Binding Item.TypeGlyph}"
                                        TextWrapping="WrapWithOverflow">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Item.Rarity}" Value="Dynamic">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock
                                        MaxWidth="250"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Panel.ZIndex="1"
                                        FontFamily="{DynamicResource Marathon Shapiro}"
                                        FontSize="16"
                                        Text="{Binding Item.Name}"
                                        TextWrapping="WrapWithOverflow">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Item.Rarity}" Value="Dynamic">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>

                            </Viewbox>

                            <TextBlock
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1"
                                FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                FontSize="16"
                                Opacity="1"
                                Text="{Binding Item.Type}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Item.Rarity}" Value="Dynamic">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1"
                                FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                FontSize="12"
                                Opacity="0.5"
                                Text="{Binding Item.ApiHash}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Item.Rarity}" Value="Dynamic">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </StackPanel>
                    </Grid>

                    <!--  Glyph/Icon  -->
                    <Grid
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <ContentControl
                            x:Name="IconHost"
                            Grid.Row="0"
                            MaxWidth="92"
                            MaxHeight="92"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="1"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource ItemIconTemplate}"
                            IsHitTestVisible="False"
                            Opacity="1"
                            Visibility="Visible" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="1"
                            FontFamily="{DynamicResource KH Interference Regular Keys}"
                            FontSize="50"
                            Foreground="{StaticResource ForegroundColour100}"
                            Opacity="1"
                            Text="{Binding Item.TraitGlyph}"
                            TextWrapping="WrapWithOverflow" />

                        <Grid.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Direction="0"
                                ShadowDepth="1"
                                Color="Black" />
                        </Grid.Effect>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DareEntry">
            <Grid Height="75" Background="Transparent">
                <Grid Focusable="False" IsHitTestVisible="False">
                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,0,0,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,1,0,0"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,0,1,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,1,1,0"
                        Focusable="False" />
                </Grid>

                <Grid Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button
                        Width="400"
                        local:StyleHelper.BorderThickness="0.75"
                        Click="DareEntry_Click"
                        Focusable="False"
                        IsHitTestVisible="True"
                        Style="{StaticResource ButtonTransparent}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="Root"
                                Grid.ColumnSpan="2"
                                Background="Transparent">
                                <Border.Effect>
                                    <local:PixelGradientEffect
                                        Width="{Binding ActualWidth, ElementName=Root}"
                                        Height="{Binding ActualHeight, ElementName=Root}"
                                        Center="-.25,0"
                                        ColorA="{Binding RarityColor}"
                                        ColorB="{StaticResource MarathonDarkerC}"
                                        Falloff="0.75"
                                        PixelSize="18,18" />
                                </Border.Effect>
                            </Border>

                            <Grid
                                Margin="5,5,5,5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource KH Interference Regular Keys}"
                                    FontSize="26"
                                    Text="{Binding Item.TypeGlyph}"
                                    TextWrapping="WrapWithOverflow">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Item.Rarity}" Value="Dynamic">
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource Marathon Shapiro}"
                                    FontSize="16"
                                    Text="{Binding Item.Name}"
                                    TextWrapping="WrapWithOverflow">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Item.Rarity}" Value="Standard">
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </Grid>

                            <Grid Grid.Column="1" Margin="0,0,10,0">
                                <ContentControl
                                    x:Name="IconHost"
                                    Grid.Row="0"
                                    MaxWidth="96"
                                    MaxHeight="96"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource ItemIconTemplate}"
                                    IsHitTestVisible="False"
                                    Opacity="1"
                                    Visibility="Visible" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource KH Interference Regular Keys}"
                                    FontSize="50"
                                    Foreground="{StaticResource ForegroundColour100}"
                                    Opacity="1"
                                    Text="{Binding Item.TraitGlyph}"
                                    TextWrapping="WrapWithOverflow" />

                                <Grid.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Direction="0"
                                        ShadowDepth="1"
                                        Color="Black" />
                                </Grid.Effect>
                            </Grid>
                        </Grid>
                    </Button>

                    <Border
                        BorderBrush="{Binding RarityColor, Converter={StaticResource ColorToBrush}}"
                        BorderThickness="1"
                        Focusable="False" />
                    <!--  Style="{StaticResource GreyBorderWhiteOnHover}" />  -->
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemCategory">
            <Grid
                Width="auto"
                Margin="0,0,0,0"
                HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl
                    Grid.Row="0"
                    Margin="0,5,0,5"
                    HorizontalAlignment="Left"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource CategoryHeader}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Margin" Value="0,0,0,0" />
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <Grid Grid.Row="1" VerticalAlignment="Top">
                    <local:ItemPage
                        x:Name="CategoryItems"
                        CollapsePageButtons="False"
                        Columns="{Binding Columns}"
                        IsVertical="True"
                        ItemMargin="5"
                        ItemTemplate="{StaticResource DareEntry}"
                        Items="{Binding Items}"
                        ItemsPerPage="{Binding ItemsPerPage}"
                        PageIndicatorMargin="0,0,0,-10"
                        SelectOnPageChange="False"
                        TransitionSpeed="0.075"
                        UsePlaceholders="True" />

                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Focusable="False">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Viewbox Panel.ZIndex="1">
            <Grid
                Width="1920"
                Height="990"
                Background="Transparent"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5"
                SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70*" />
                    <ColumnDefinition Width="25*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="90*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.RowSpan="3"
                    Grid.Column="1"
                    Background="{StaticResource MarathonDarker}"
                    BorderBrush="{StaticResource ForegroundColour60}"
                    BorderThickness="2,0,0,0"
                    Opacity="1" />

                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="1"
                    Background="Transparent">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*" />
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="90*" />
                        <RowDefinition Height="5*" />
                    </Grid.RowDefinitions>

                    <ToggleButton
                        x:Name="AggregateOutputButton"
                        Grid.Row="1"
                        Margin="15,-15,15,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="AGGREGATE OUTPUT"
                        FontSize="18"
                        Style="{DynamicResource D2StyleToggleBoxButton}">
                        <local:GenericTooltipProperties.TooltipData>
                            <local:GenericTooltip
                                Name="AGGREGATE OUTPUT"
                                Description="Exports selected items to a singular folder in your output path.&#x0a;&#x0a;The folder will be named 'ApiOutput#', where the hashtag represents the current ApiOutput folder count"
                                Type="Export Option" />
                        </local:GenericTooltipProperties.TooltipData>
                    </ToggleButton>

                    <Grid Grid.Row="1" Margin="0,15,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="ExportButton"
                            Grid.Column="0"
                            Margin="15,10,15,10"
                            Click="ExportButton_Click"
                            Style="{DynamicResource MarathonStyleButton}">
                            <local:GenericTooltipProperties.TooltipData>
                                <local:GenericTooltip Name="EXPORT" Description="Exports everything in the export list" />
                            </local:GenericTooltipProperties.TooltipData>
                            <TextBlock
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                FontSize="18"
                                Text="EXPORT" />
                        </Button>

                        <Button
                            x:Name="OpenOutputButton"
                            Grid.Column="1"
                            Margin="0,10,0,10"
                            Click="OpenOutputFolder_Click"
                            Style="{DynamicResource MarathonStyleButton}">
                            <local:GenericTooltipProperties.TooltipData>
                                <local:GenericTooltip Name="OPEN OUTPUT" Description="Opens the output folder for your rips" />
                            </local:GenericTooltipProperties.TooltipData>
                            <TextBlock
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                FontSize="18"
                                Text="OPEN OUTPUT" />
                        </Button>

                        <Button
                            x:Name="ClearAllButton"
                            Grid.Column="2"
                            Margin="15,10,15,10"
                            Click="ClearAllButton_Click"
                            Style="{DynamicResource MarathonStyleButton}">
                            <local:GenericTooltipProperties.TooltipData>
                                <local:GenericTooltip Name="CLEAR" Description="Clears everything from the export list" />
                            </local:GenericTooltipProperties.TooltipData>
                            <TextBlock
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                                FontSize="18"
                                Text="CLEAR" />
                        </Button>
                    </Grid>

                    <local:ItemPage
                        x:Name="SelectedItemsList"
                        Grid.Row="2"
                        Margin="15,0,15,0"
                        CollapsePageButtons="False"
                        Columns="1"
                        IsVertical="True"
                        ItemMargin="3,0,3,0"
                        ItemTemplate="{StaticResource DareSelectedEntry}"
                        Items="{Binding SelectedItems}"
                        ItemsPerPage="7"
                        PageIndicatorMargin="0,0,0,-10"
                        SelectOnPageChange="False"
                        ShowVerticalPageIndicator="True"
                        UsePlaceholders="True"
                        UseStackPanel="False" />
                </Grid>

                <Grid
                    x:Name="MainGrid"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="25,0,0,0"
                    ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="95*" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="HelpButton"
                        Grid.Column="0"
                        Width="50"
                        Height="50"
                        HorizontalAlignment="Left"
                        Panel.ZIndex="10"
                        local:StyleHelper.CornerRadius="100"
                        Click="HelpButton_Click"
                        Opacity="0.5"
                        Style="{DynamicResource MarathonStyleButton}">
                        <TextBlock
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Marathon Shapiro}"
                            FontSize="32"
                            Text="?" />
                    </Button>

                    <Grid Grid.Row="0" Grid.Column="1">
                        <StackPanel
                            x:Name="FilterOptions"
                            Grid.Row="0"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="SearchBox"
                                Grid.Row="0"
                                Width="350"
                                Margin="10,0,10,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                FontSize="30"
                                TextChanged="SearchBox_TextChanged"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <local:ItemPage
                        x:Name="Categories"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        VerticalAlignment="Stretch"
                        Columns="3"
                        HidePageButtons="False"
                        IsVertical="False"
                        ItemMargin="0,0,0,0"
                        ItemTemplate="{StaticResource ItemCategory}"
                        Items="{Binding ItemCategories}"
                        ItemsPerPage="3"
                        PageIndicatorMargin="0,0,0,0"
                        SelectOnPageChange="False"
                        ShowVerticalPageIndicator="True"
                        SlideDistance="5"
                        TransitionSpeed="0.075"
                        UsePlaceholders="False"
                        UseStackPanel="False" />

                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,50,0,50"
                        HorizontalAlignment="Right">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*" />
                            <RowDefinition Height="50*" />
                        </Grid.RowDefinitions>

                        <Button
                            x:Name="PreviousPage"
                            Width="50"
                            Height="Auto"
                            Margin="2,0,0,0"
                            local:StyleHelper.BorderThickness="1"
                            Focusable="False"
                            Visibility="Collapsed">
                            <Button.Style>
                                <Style BasedOn="{StaticResource MarathonStyleButton}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVertical}" Value="False">
                                            <Setter Property="Width" Value="Auto" />
                                            <Setter Property="Height" Value="35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Border Background="#33FFFFFF" Focusable="False">
                                <Polygon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="Black"
                                    Points="0, 0 60, 50, 0, 100">
                                    <Polygon.Style>
                                        <Style TargetType="Polygon">
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                            <Setter Property="LayoutTransform">
                                                <Setter.Value>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="0.15" ScaleY="0.15" />
                                                        <RotateTransform Angle="-90" />
                                                    </TransformGroup>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVertical}" Value="True">
                                                    <Setter Property="LayoutTransform">
                                                        <Setter.Value>
                                                            <TransformGroup>
                                                                <ScaleTransform ScaleX="0.15" ScaleY="0.15" />
                                                                <RotateTransform Angle="00" />
                                                            </TransformGroup>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Polygon.Style>
                                </Polygon>
                            </Border>
                        </Button>

                        <Button
                            x:Name="NextPage"
                            Grid.Row="1"
                            Width="50"
                            Height="Auto"
                            Margin="2,0,0,0"
                            local:StyleHelper.BorderThickness="1"
                            Focusable="False"
                            Visibility="Collapsed">
                            <Button.Style>
                                <Style BasedOn="{StaticResource MarathonStyleButton}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVertical}" Value="False">
                                            <Setter Property="Width" Value="Auto" />
                                            <Setter Property="Height" Value="35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Border Background="#33FFFFFF" Focusable="False">
                                <Polygon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="Black"
                                    Points="0, 0 60, 50, 0, 100">
                                    <Polygon.Style>
                                        <Style TargetType="Polygon">
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                            <Setter Property="LayoutTransform">
                                                <Setter.Value>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="0.15" ScaleY="0.15" />
                                                        <RotateTransform Angle="90" />
                                                    </TransformGroup>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVertical}" Value="True">
                                                    <Setter Property="LayoutTransform">
                                                        <Setter.Value>
                                                            <TransformGroup>
                                                                <ScaleTransform ScaleX="0.15" ScaleY="0.15" />
                                                                <RotateTransform Angle="00" />
                                                            </TransformGroup>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Polygon.Style>
                                </Polygon>
                            </Border>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
