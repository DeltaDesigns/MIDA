<UserControl
    x:Class="MIDA.PackageList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MIDA"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="NormalPanel">
            <StackPanel Margin="10,5,10,5" Orientation="Vertical" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="VirtualizedPanel">
            <VirtualizingStackPanel
                Margin="10,5,10,5"
                IsVirtualizing="True"
                VirtualizationMode="Recycling" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="PackageItemTemplate">
            <RadioButton
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                local:StyleHelper.BorderThickness="1"
                Checked="PackageItem_Checked"
                Focusable="False"
                Foreground="Transparent"
                GroupName="PackageItem"
                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                Style="{DynamicResource D2StyleRadioButton}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Viewbox
                        Grid.Row="0"
                        Margin="15,10,15,10"
                        HorizontalAlignment="Left"
                        StretchDirection="DownOnly">
                        <TextBlock
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Marathon Shapiro}"
                            FontSize="16"
                            Foreground="Black"
                            Text="{Binding Name}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!--  Trigger when IsSelected (IsChecked) is false  -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="Opacity" Value="0.75" />
                                        </DataTrigger>
                                        <!--  Trigger when IsSelected (IsChecked) is true  -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Viewbox>


                    <TextBlock
                        Grid.Row="1"
                        Margin="15,5,15,10"
                        HorizontalAlignment="Left"
                        d:FontFamily="Haas Grot Text 55 Roman"
                        FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                        FontSize="16"
                        Foreground="Black">
                        <Run Text="{Binding Content}" />
                        <Run Text=": " />
                        <Run Text="{Binding Count}" />
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!--  Trigger when IsSelected (IsChecked) is false  -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Opacity" Value="0.75" />
                                    </DataTrigger>
                                    <!--  Trigger when IsSelected (IsChecked) is true  -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Opacity" Value="1.0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock
                        Grid.Row="1"
                        Margin="15,5,15,10"
                        HorizontalAlignment="Right"
                        d:FontFamily="Haas Grot Text 55 Roman"
                        FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                        FontSize="14"
                        Foreground="Black"
                        Text="{Binding Subname}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!--  Trigger when IsSelected (IsChecked) is false  -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Opacity" Value="0.75" />
                                    </DataTrigger>
                                    <!--  Trigger when IsSelected (IsChecked) is true  -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Opacity" Value="1.0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

            </RadioButton>
        </DataTemplate>
    </UserControl.Resources>


    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="95*" />
        </Grid.RowDefinitions>
        <Border
            Grid.RowSpan="2"
            Margin="0,15,0,15"
            BorderBrush="{StaticResource ForegroundColour70}"
            BorderThickness="0,0,1,0" />

        <TextBox
            x:Name="SearchBox"
            Grid.Row="0"
            Margin="15,0,15,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            FontSize="30"
            TextChanged="SearchBox_TextChanged"
            TextWrapping="Wrap" />

        <ListView
            x:Name="PackageListView"
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            ItemTemplate="{StaticResource PackageItemTemplate}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            VirtualizingPanel.IsVirtualizing="True">

            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="ItemsPanel" Value="{StaticResource NormalPanel}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UseVirtualizingStackPanel}" Value="True">
                            <Setter Property="ItemsPanel" Value="{StaticResource VirtualizedPanel}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>

        </ListView>

    </Grid>



</UserControl>
