<UserControl
    x:Class="MIDA.PortingConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MIDA"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    Loaded="OnControlLoaded"
    mc:Ignorable="d">
    <!--  TODO move entries into a template or something  -->
    <Grid Margin="100,75,100,75" Background="Transparent">
        <StackPanel Margin="0" Orientation="Vertical">

            <ContentControl Content="S&amp;BOX (SOURCE 2)" Template="{StaticResource MarathonCategoryLabelNoPlus}" />
            <StackPanel
                x:Name="S2ConfigPanel"
                Margin="0,10,0,50"
                Orientation="Vertical" />
            <Border Margin="20" />

        </StackPanel>
    </Grid>
</UserControl>
