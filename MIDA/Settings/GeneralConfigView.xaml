<UserControl
    x:Class="MIDA.GeneralConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MIDA"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="945"
    d:DesignWidth="1914"
    Loaded="OnControlLoaded"
    mc:Ignorable="d">
    <Grid Margin="100,50,100,50" Background="Transparent">
        <StackPanel Margin="0" Orientation="Vertical">

            <ContentControl Content="GENERAL" Template="{StaticResource MarathonCategoryLabel}" />
            <StackPanel
                x:Name="GeneralConfigPanel"
                Margin="10,0,0,0"
                Orientation="Vertical" />

            <Border Margin="20" />

            <ContentControl Content="MISC" Template="{StaticResource MarathonCategoryLabel}" />
            <StackPanel
                x:Name="MiscConfigPanel"
                Margin="10,0,0,0"
                Orientation="Vertical" />
        </StackPanel>
    </Grid>
</UserControl>
