<UserControl
    x:Class="MIDA.GeneralConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MIDA"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="945"
    d:DesignWidth="1914"
    Loaded="OnControlLoaded"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <ScrollViewer
            Margin="50,75,50,75"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar">
                    <Setter Property="Width" Value="7" />
                </Style>
            </ScrollViewer.Resources>

            <StackPanel Margin="50,0,50,0" Orientation="Vertical">

                <ContentControl Content="GENERAL" Template="{StaticResource MarathonCategoryLabelNoPlus}" />
                <StackPanel
                    x:Name="GeneralConfigPanel"
                    Margin="0,0,0,0"
                    Orientation="Vertical" />
                <Border Margin="20" />

                <ContentControl Content="MATERIALS" Template="{StaticResource MarathonCategoryLabelNoPlus}" />
                <StackPanel
                    x:Name="MaterialsConfigPanel"
                    Margin="0,0,0,0"
                    Orientation="Vertical" />
                <Border Margin="20" />

                <ContentControl Content="MISC" Template="{StaticResource MarathonCategoryLabelNoPlus}" />
                <StackPanel
                    x:Name="MiscConfigPanel"
                    Margin="0,0,0,0"
                    Orientation="Vertical" />
                <Border Margin="20" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
