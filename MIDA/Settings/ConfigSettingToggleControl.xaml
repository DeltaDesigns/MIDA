<UserControl
    x:Class="MIDA.ConfigSettingToggleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MIDA"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="1920"
    mc:Ignorable="d">
    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80*" />
            <ColumnDefinition Width="20*" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.ColumnSpan="3"
            Background="#B140454F"
            CornerRadius="10" />
        <StackPanel
            Grid.Column="0"
            Margin="20,0,20,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <TextBlock
                Margin="0,3,0,3"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                FontSize="24"
                Foreground="{StaticResource ForegroundColour90}"
                Text="{Binding SettingName}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,0,0,3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                FontSize="18"
                Foreground="{StaticResource ForegroundColour50}"
                Text="{Binding SettingLabel}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingLabel}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Button
            x:Name="ChangeButton"
            Grid.Column="2"
            Margin="0"
            Style="{DynamicResource D2StyleButton}">
            <TextBlock
                d:FontFamily="Haas Grot Text 55 Roman"
                FontFamily="{DynamicResource PP Fraktion Mono Medium}"
                FontSize="24"
                Text="{Binding SettingValue}" />
        </Button>
    </Grid>
</UserControl>
